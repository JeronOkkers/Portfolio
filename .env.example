# Copy to .env.local for local dev. Set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Supabase project "portfolio-health"
SUPABASE_URL=https://brkafhwgajfemlgnpudl.supabase.co
# Supabase → Project Settings → API Keys → secret key (sb_secret_…). Server only.
SUPABASE_SECRET_KEY=

# The HMAC signing secret from the Life Dashboard Companion app (Webhook → HMAC signing secret → Generate → Copy)
HEALTH_WEBHOOK_SECRET=

# Optional: "health-connect" (default) or "none" to hide live stats
HEALTH_PROVIDER=health-connect
# Optional: timezone offset in minutes for "today" (SAST = 120)
HEALTH_TZ_OFFSET_MINUTES=120
