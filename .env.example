# Copy to .env.local for local dev. Set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client
GOOGLE_REDIRECT_URI=https://jeronokkers.vercel.app/api/health/callback

# Long random string. Only someone with this key can start the Google connect flow.
HEALTH_ADMIN_KEY=

# Filled in after you connect once via /api/health/connect?key=HEALTH_ADMIN_KEY
GOOGLE_FIT_REFRESH_TOKEN=

# Which health provider to use: "google-fit" (until Google shuts it down) or "none"
HEALTH_PROVIDER=google-fit
